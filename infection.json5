{
    // Teste de mutação (Infection): `composer mutacao`. Precisa de pcov ou xdebug e do banco de
    // teste. Métrica do bin/qualidade: MSI (% de mutantes mortos pelos testes). Mede se os
    // testes conferem o comportamento, e não só se executam as linhas (cobertura).
    //
    // Onde fica a lógica que não é só cola do CakePHP: criptografia, auditoria, idioma/fuso, logs,
    // o validador e as entities (criptografia dos campos, 2FA). Controllers e Tables entram na
    // cobertura.
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src/Auditoria",
            "src/Criptografia",
            "src/I18n",
            "src/Log",
            "src/Model/Custom",
            "src/Model/Entity"
        ]
    },
    // Um processo só: os testes dividem o mesmo banco de teste, e mutantes em paralelo
    // disputariam as fixtures.
    "threads": 1,
    "timeout": 30,
    // Pasta temporária do próprio projeto: com a padrão (/tmp/infection), duas execuções ao
    // mesmo tempo em projetos diferentes apagam a cobertura uma da outra.
    "tmpDir": "build/infection-tmp",
    "logs": {
        "text": "build/infection.log",
        "json": "build/infection.json",
        "summary": "build/infection-resumo.log"
    },
    "mutators": {
        "@default": true,
        // Os casts ((string), (int), (bool), (array), (float)) só geravam mutantes equivalentes:
        // num valor que já é do tipo, tirar o cast não muda nada que um teste possa ver.
        "@cast": false
    }
    // Sem minMsi por enquanto: a regra é a catraca do bin/qualidade (qualidade-referencia.json),
    // que não deixa o MSI cair mais de 0,5 ponto.
}
